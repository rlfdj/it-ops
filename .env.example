# Copy to .env.local for local development. Never commit real values.

# Direct Postgres connection (Supabase → Project Settings → Database → Connection string).
# Used by `next dev`, drizzle-kit migrations and the seed script.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase → Project Settings → API Keys. Public values, inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by setup scripts (storage bucket) — never exposed to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# The only address allowed to sign in.
ALLOWED_EMAIL=alex@example.com
